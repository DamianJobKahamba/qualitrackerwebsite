{
  "name": "@workspace/lead-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gcp-build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "start": "functions-framework --source=dist/index.js --target=submitLead --port=8080"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.3.1",
    "@google-cloud/functions-framework": "5.0.5",
    "google-auth-library": "11.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
