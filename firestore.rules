rules_version = '2';
// Deny everything to browsers and mobile clients. The only writer is the lead-api Cloud Run
// function, which uses the Admin/server SDK with its service account (that bypasses these rules).
// Never loosen this: the `leads` collection holds visitors' personal data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
